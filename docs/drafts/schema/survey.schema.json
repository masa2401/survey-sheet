{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "survey.schema.json",
  "title": "設問の定義（survey.json）",
  "description": "グループ・設問・項目の定義（書き換えると版が変わり、保存済みの回答は無効になる）",
  "type": "object",
  "required": ["alwaysShownGroups", "selectableGroups"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "エディタがこのスキーマを読み込むためのパス",
      "type": "string"
    },
    "alwaysShownGroups": {
      "description": "全員が回答するグループ（TOP の選択肢には出さず、回答ページに必ず表示する）",
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/alwaysShownGroup" }
    },
    "selectableGroups": {
      "description": "回答者が TOP で選んだときだけ表示するグループ",
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/selectableGroup" }
    }
  },
  "$defs": {
    "plainText": {
      "$comment": "画面に表示する文字列の共通の規則（空欄、先頭・末尾の空白、制御文字を拒否する）。参照する側の description がエディタに表示されるよう、ここには description を書かない",
      "type": "string",
      "pattern": "^[^\\p{Cc}\\p{Zs}]([^\\p{Cc}]*[^\\p{Cc}\\p{Zs}])?$",
      "patternErrorMessage": "空欄や、先頭・末尾の空白、改行・タブなどの制御文字は使えません。"
    },
    "alwaysShownGroup": {
      "type": "object",
      "required": ["id", "label", "questions"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/groupId" },
        "label": { "$ref": "#/$defs/groupLabel" },
        "questions": { "$ref": "#/$defs/groupQuestions" }
      }
    },
    "selectableGroup": {
      "type": "object",
      "required": ["id", "label", "questions"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/groupId" },
        "label": { "$ref": "#/$defs/groupLabel" },
        "description": {
          "description": "グループの説明（TOP の選択肢のカードに表示する）",
          "type": "string",
          "$ref": "#/$defs/plainText",
          "maxLength": 60
        },
        "questions": { "$ref": "#/$defs/groupQuestions" }
      }
    },
    "groupId": {
      "description": "グループの識別子（display.json のアイコンから参照する、2つの配列をまたいで重複させない）",
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "patternErrorMessage": "小文字英字で始め、以降は小文字英数字とハイフンが使えます。ハイフンは末尾や連続では使えません。"
    },
    "groupLabel": {
      "description": "グループの名前（TOP・回答ページ・結果ページ・CSV に表示する）",
      "type": "string",
      "$ref": "#/$defs/plainText",
      "maxLength": 30
    },
    "groupQuestions": {
      "description": "設問（書いた順に番号が振られる）",
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/question" }
    },
    "question": {
      "type": "object",
      "required": ["title", "prompt", "items"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "description": "設問の見出し",
          "type": "string",
          "$ref": "#/$defs/plainText",
          "maxLength": 40
        },
        "prompt": {
          "description": "見出しの下に表示する、回答方法の案内",
          "type": "string",
          "$ref": "#/$defs/plainText",
          "maxLength": 100
        },
        "items": {
          "description": "回答者がチェックして5段階で評価する項目（書いた順に番号が振られる）",
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "$ref": "#/$defs/plainText",
            "maxLength": 100
          }
        }
      }
    }
  }
}
